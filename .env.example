# Copy to .env. Lines of the form "# NAME=value" show a default. Leave them commented: an empty value would replace the default.

# FalkorDB host. Default 127.0.0.1.
# FALKORDB_HOST=127.0.0.1
# FalkorDB port. Default 6379.
# FALKORDB_PORT=6379
# FalkorDB password. Leave empty when the instance has none.
FALKORDB_PASSWORD=

# OpenAI key. Without it the Resolver uses its deterministic signals only and free-form Ask is off.
OPENAI_API_KEY=
# OpenAI chat model. Default gpt-5-mini.
# OPENAI_MODEL=gpt-5-mini
# OpenAI embedding model. Default text-embedding-3-small.
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Bright Data account API key (SERP API, Web Unlocker, Web Scraper). Without Bright Data, discovery runs on Exa alone.
BRIGHTDATA_API_KEY=
# Web Unlocker zone name. Default web_unlocker1.
# BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
# SERP API zone name. Default serp_api1.
# BRIGHTDATA_SERP_ZONE=serp_api1
# Zone-password route, an alternative to the API key. Bright Data customer ID.
BRIGHTDATA_CUSTOMER=
# SERP zone password (proxy mode).
BRIGHTDATA_SERP_PASSWORD=
# Browser API zone password (Bluesky and blocked pages over CDP).
BRIGHTDATA_BROWSER_PASSWORD=
# Browser API zone name. Default web_unlocker1.
# BRIGHTDATA_BROWSER_ZONE=web_unlocker1

# Exa key for post discovery.
EXA_API_KEY=

# Set to 0 to turn off the background live pull (every 3 minutes while a live conference is in its dates). Default 1.
# BACKSTAGE_LIVE=1
# Port for python -m app.server. Default 8080.
# PORT=8080
